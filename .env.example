# Sparta SCADA — local development environment
# Copy this file to .env and adjust values as needed.
COMPOSE_PROJECT_NAME=sparta-scada

# PostgreSQL
POSTGRES_HOST=sparta-postgres
POSTGRES_PORT=5432
POSTGRES_DB=scada
POSTGRES_USER=scada
POSTGRES_PASSWORD=scada

# AI service (Stage 2)
AI_SERVICE_PORT=8000
AI_DATABASE_URL=postgresql://scada:scada@sparta-postgres:5432/scada

# MCP server (Stage 3)
MCP_SERVER_PORT=8001
MCP_AI_SERVICE_URL=http://sparta-ai-service:8000

# ERP emulator (Stage 4)
ERP_EMULATOR_PORT=8002
ERP_BASE_URL=http://sparta-erp-emulator:8002
